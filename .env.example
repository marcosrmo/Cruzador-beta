# ===========================================
# VARIAVEIS DE AMBIENTE - Cruzador de Planilhas
# ===========================================
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env no git!

# ===========================================
# BANCO DE DADOS (Neon)
# ===========================================
# Obtenha essa URL no dashboard do Neon:
# https://console.neon.tech
# Exemplo: postgresql://user:senha@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ===========================================
# AUTENTICACAO
# ===========================================
# Senha secreta para criptografar sessoes
# Use uma senha longa e aleatoria (minimo 32 caracteres)
# Exemplo: J7kL9mN2pQ4rT6vX8yZ0AaBbCcDdEeFfGgHh
SESSION_SECRET=

# ===========================================
# USUARIO ADMIN
# ===========================================
# Usuario e senha do administrador inicial
# Esses valores sao usados apenas no primeiro seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ===========================================
# AMBIENTE
# ===========================================
# development = ambiente de desenvolvimento
# production = ambiente de producao (Render/Neon)
NODE_ENV=production

# ===========================================
# SERVIDOR (opcional)
# ===========================================
# Porta do servidor (Render define automaticamente)
# PORT=5000
